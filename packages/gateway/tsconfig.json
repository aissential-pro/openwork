{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "isolatedModules": true,
    "noResolve": false,
    "paths": {
      "@/*": ["../openwork/src/*"],
      "@tui/*": ["../openwork/src/cli/cmd/tui/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "../openwork", "../sdk"]
}
