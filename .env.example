# OpenWork Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Allowed Telegram User IDs (comma-separated)
# Get your user ID by sending /start to @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# ============================================
# SERVER CONFIGURATION
# ============================================

# Port for HTTP API (default: 3000)
PORT=3000

# Host binding (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Node environment (development or production)
NODE_ENV=production

# ============================================
# OPTIONAL API KEYS
# ============================================

# OpenAI API Key (if using GPT models)
# OPENAI_API_KEY=sk-your-openai-key-here

# Google API Key (if using Gemini models)
# GOOGLE_API_KEY=your-google-api-key-here

# Perplexity API Key (if using Perplexity models)
# PERPLEXITY_API_KEY=your-perplexity-key-here

# Groq API Key (if using Groq models)
# GROQ_API_KEY=your-groq-key-here

# OpenRouter API Key (if using OpenRouter)
# OPENROUTER_API_KEY=your-openrouter-key-here

# ============================================
# FILE PATHS AND STORAGE
# ============================================

# Session storage directory (optional, defaults to ./sessions)
# SESSION_STORAGE_PATH=/home/user/openwork/sessions

# Business files directory (optional, defaults to ~/business)
# BUSINESS_FILES_PATH=/home/user/business

# Agent memory file (optional, defaults to ~/business/agent.md)
# AGENT_MD_PATH=/home/user/business/agent.md

# ============================================
# LOGGING
# ============================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Log file path (optional, defaults to stdout/stderr)
# LOG_FILE_PATH=/home/user/openwork/logs/openwork.log

# ============================================
# BACKUP CONFIGURATION
# ============================================

# Backup directory (default: ~/backups)
# BACKUP_PATH=/home/user/backups

# ============================================
# ADVANCED CONFIGURATION
# ============================================

# Default model for main agent (default: claude-sonnet-4-5-20250929)
# MAIN_AGENT_MODEL=claude-opus-4-5-20251101

# Default model for sub-agents (default: claude-sonnet-4-5-20250929)
# SUB_AGENT_MODEL=claude-sonnet-4-5-20250929

# Maximum concurrent sessions (default: 10)
# MAX_CONCURRENT_SESSIONS=10

# Session timeout in milliseconds (default: 3600000 = 1 hour)
# SESSION_TIMEOUT=3600000

# API request timeout in milliseconds (default: 300000 = 5 minutes)
# API_TIMEOUT=300000

# Maximum message length for Telegram (default: 4096)
# MAX_MESSAGE_LENGTH=4096

# ============================================
# MCP (Model Context Protocol) INTEGRATIONS
# ============================================

# Google Drive MCP Configuration
# GOOGLE_DRIVE_CLIENT_ID=your-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token

# Database MCP Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================
# SECURITY
# ============================================

# JWT secret for API authentication (if using API authentication)
# JWT_SECRET=your-random-secret-key-here

# API rate limiting (requests per minute per user, default: 60)
# RATE_LIMIT_PER_MINUTE=60

# ============================================
# MONITORING AND ALERTS
# ============================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Webhook for status alerts (optional)
# ALERT_WEBHOOK_URL=https://your-webhook-url

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Enable debug mode (verbose logging)
# DEBUG=true

# Mock API responses (for testing without API keys)
# MOCK_MODE=false
