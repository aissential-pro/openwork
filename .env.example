# OpenWork Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: These 3 variables are required
# ============================================

# Anthropic API Key
# Get yours at: https://console.anthropic.com
# This is used to power the AI agent with Claude
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Telegram Bot Token
# Create a bot: Send /newbot to @BotFather on Telegram
# You'll receive a token that looks like: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Allowed Telegram User IDs (comma-separated)
# Find your user ID: Send /start to @userinfobot on Telegram
# For multiple users: 123456789,987654321
ALLOWED_USER_IDS=123456789

# ============================================
# OPTIONAL: Advanced Configuration
# ============================================

# Working Directory
# Where the agent can read/write files (default: ~/business)
# OPENWORK_WORKING_DIR=/home/user/business

# LLM Model
# Default: claude-sonnet-4-20250514
# Options: claude-opus-4-20250514, claude-sonnet-4-20250514
# OPENWORK_MODEL=claude-sonnet-4-20250514

# Alternative LLM Providers (instead of Anthropic)
# Uncomment and use ONE of these if you prefer:

# OpenAI API Key
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENWORK_MODEL=gpt-4o

# Google API Key (for Gemini)
# GOOGLE_API_KEY=your-google-api-key-here
# OPENWORK_MODEL=gemini-2.0-flash-001

# OpenRouter (access multiple models with one API key)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENWORK_MODEL=openrouter/anthropic/claude-sonnet-4-20250514

# Log Level (default: info)
# Options: debug, info, warn, error
# LOG_LEVEL=info

# Server Configuration (usually not needed for local use)
# PORT=3000
# HOST=127.0.0.1
# NODE_ENV=development
